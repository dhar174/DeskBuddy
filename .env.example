# Load explicitly: deskbuddy --env-file .env (no implicit checkout .env search).
# Copy to .env; the real file is ignored by Git. No credentials are supplied here.
DESKBUDDY_MODEL_PROVIDER=disabled
DESKBUDDY_LOCAL_MODEL_ENDPOINT=http://127.0.0.1:11434
DESKBUDDY_OPENAI_MODEL=gpt-3.5-turbo
OPENAI_API_KEY=
DESKBUDDY_MEDIUM_MODEL_ID=PygmalionAI/pygmalion-350m
DESKBUDDY_FAST_MODEL_ID=microsoft/DialoGPT-large
DESKBUDDY_SMALL_MODEL_ID=facebook/blenderbot_small-90M
DESKBUDDY_BLENDERBOT_MODEL_ID=facebook/blenderbot-400M-distill
DESKBUDDY_VISION_MODEL_ID=microsoft/git-large-vqav2
DESKBUDDY_TOPIC_MODEL_ID=knkarthick/TOPIC-DIALOGSUM
DESKBUDDY_SUMMARY_MODEL_ID=philschmid/bart-large-cnn-samsum
DESKBUDDY_SHORT_SUMMARY_MODEL_ID=knkarthick/meeting-summary-samsum
DESKBUDDY_TITLE_MODEL_ID=fabiochiu/t5-small-medium-title-generation
DESKBUDDY_SPACY_MODEL_ID=en_core_web_trf
DESKBUDDY_QUESTION_CLASSIFIER_MODEL_ID=shahrukhx01/question-vs-statement-classifier
DESKBUDDY_NLI_MODEL_ID=valhalla/distilbart-mnli-12-3
DESKBUDDY_COMMAND_MODEL_ID=gokuls/bert-tiny-Massive-intent-KD-BERT
DESKBUDDY_QUESTION_GENERATOR_MODEL_ID=voidful/context-only-question-generator
DESKBUDDY_EMBEDDING_MODEL_ID=sentence-transformers/all-mpnet-base-v2
DESKBUDDY_COMPLETION_MODEL_ID=text-curie-001
DESKBUDDY_SD_CLASSIFIER_MODEL_ID=curie
DESKBUDDY_QA_MODEL_ID=distilbert-base-cased-distilled-squad
# Omit paths for OS-specific user data/cache defaults. Relative paths use data_dir.
# DESKBUDDY_DATA_DIR=workspace
# DESKBUDDY_CACHE_DIR=cache
# DESKBUDDY_OFFLOAD_DIR=offload
# Legacy Large mode needs existing checkpoint AND tokenizer directories.
# DESKBUDDY_CHECKPOINT_DIR=models/checkpoint
# DESKBUDDY_TOKENIZER_DIR=models/pygmalion-6b
DESKBUDDY_ROBOT_HOST=127.0.0.1
# For separate robot/client machines, set HOST to the robot's reachable address
# and BIND_ADDRESS on the robot to its local LAN interface. Loopback accepts only
# same-machine clients. Transport authentication enforcement arrives with Issue #4.
DESKBUDDY_ROBOT_BIND_ADDRESS=127.0.0.1
DESKBUDDY_ROBOT_PORT=8888
# Issue #4 must enforce this secret and the timeouts in its replacement transport.
DESKBUDDY_ROBOT_AUTH_SECRET=
DESKBUDDY_ROBOT_CONNECT_TIMEOUT_SECONDS=5
DESKBUDDY_ROBOT_TIMEOUT_SECONDS=5
# Empty disables camera configuration; use 0 for first webcam, URL, or image path.
DESKBUDDY_CAMERA_SOURCE=
DESKBUDDY_DEVICE=auto
DESKBUDDY_GPU_MEMORY_LIMIT=auto
DESKBUDDY_CPU_MEMORY_LIMIT=auto
# Optional file selectors (paths relative to caller's working directory):
# DESKBUDDY_CONFIG_FILE=deskbuddy.toml
# DESKBUDDY_ENV_FILE=.env
